<?xml version="1.0" encoding="UTF-8"?>
<!-- High-volume flows reflecting Silk Board's real notorious congestion:
     heavy Hosur Rd <-> ORR IT-corridor commute traffic, plus Electronic City connector -->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="4.5" minGap="2.5" maxSpeed="16.7"/>
    <vType id="auto" accel="2.2" decel="4.0" sigma="0.6" length="2.8" minGap="2.0" maxSpeed="12.0"/>
    <vType id="bus" accel="1.8" decel="3.5" sigma="0.4" length="10.0" minGap="3.0" maxSpeed="14.0"/>
    <vType id="bike" accel="3.0" decel="5.0" sigma="0.7" length="2.0" minGap="1.5" maxSpeed="18.0"/>

    <route id="HosurN_to_HosurS" edges="HosurN_in HosurS_out"/>
    <route id="HosurS_to_HosurN" edges="HosurS_in HosurN_out"/>
    <route id="ORR_E_to_ORR_W"   edges="ORR_E_in ORR_W_out"/>
    <route id="ORR_W_to_ORR_E"   edges="ORR_W_in ORR_E_out"/>
    <route id="HosurS_to_EC"     edges="HosurS_in EC_out"/>
    <route id="EC_to_HosurN"     edges="EC_in HosurN_out"/>
    <route id="ORR_W_to_EC"      edges="ORR_W_in EC_out"/>

    <!-- Main Hosur Road commuter flow (very heavy - this is the real bottleneck direction) -->
    <flow id="flow_HosurN_car" type="car" route="HosurN_to_HosurS" begin="0" end="3600" vehsPerHour="600"/>
    <flow id="flow_HosurS_car" type="car" route="HosurS_to_HosurN" begin="0" end="3600" vehsPerHour="600"/>
    <flow id="flow_HosurN_bike" type="bike" route="HosurN_to_HosurS" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_HosurN_bus" type="bus" route="HosurN_to_HosurS" begin="0" end="3600" vehsPerHour="30"/>

    <!-- Outer Ring Road IT-corridor flow (also very heavy) -->
    <flow id="flow_ORR_E_car" type="car" route="ORR_E_to_ORR_W" begin="0" end="3600" vehsPerHour="550"/>
    <flow id="flow_ORR_W_car" type="car" route="ORR_W_to_ORR_E" begin="0" end="3600" vehsPerHour="550"/>
    <flow id="flow_ORR_E_bike" type="bike" route="ORR_E_to_ORR_W" begin="0" end="3600" vehsPerHour="250"/>

    <!-- Electronic City connector traffic -->
    <flow id="flow_EC_1" type="car" route="HosurS_to_EC" begin="0" end="3600" vehsPerHour="200"/>
    <flow id="flow_EC_2" type="car" route="EC_to_HosurN" begin="0" end="3600" vehsPerHour="200"/>
    <flow id="flow_EC_3" type="auto" route="ORR_W_to_EC" begin="0" end="3600" vehsPerHour="100"/>
</routes>
