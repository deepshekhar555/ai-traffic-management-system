<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nodes for a single 4-way signalized intersection.
  Replace the coordinates below with your real intersection's coordinates
  if you export from OpenStreetMap via netconvert instead of using this
  hand-built network. Units are meters on a local plane.
-->
<nodes>
    <node id="center" x="0" y="0" type="traffic_light"/>
    <node id="north"  x="0" y="200" type="priority"/>
    <node id="south"  x="0" y="-200" type="priority"/>
    <node id="east"   x="200" y="0" type="priority"/>
    <node id="west"   x="-200" y="0" type="priority"/>
</nodes>
